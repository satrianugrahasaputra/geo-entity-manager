# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Nilai di bawah hanya untuk pengembangan lokal. Jangan dipakai di produksi.

# --- PostgreSQL (dipakai oleh service `db` di docker compose) ---
POSTGRES_USER=geo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geo_entities
POSTGRES_PORT=5432

# --- Backend API ---
# Di dalam docker compose host DB adalah `db`; saat menjalankan tanpa Docker gunakan `localhost`.
DATABASE_URL=postgres://geo:change-me@localhost:5432/geo_entities?sslmode=disable
HTTP_PORT=8080
# Daftar origin yang diizinkan CORS, dipisah koma (dipakai saat dev tanpa proxy).
CORS_ORIGINS=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=info
# true = isi data contoh saat start jika tabel masih kosong
SEED_DATA=true

# --- Test integrasi repository (opsional; test di-skip bila kosong) ---
# Disarankan memakai database terpisah agar data tidak tercampur.
TEST_DATABASE_URL=

# --- Frontend ---
WEB_PORT=3000
